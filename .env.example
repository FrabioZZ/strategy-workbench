# 复制为 .env 后填写；不要将密钥提交到版本控制。修改后重启服务。
# 本地模型必须预先下载；应用不会静默下载 ASR 或大语言模型。
ASR_MODEL_PATH=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# openai 或 ollama；留空时界面可运行，提取会明确报未配置。
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# OpenAI兼容示例：AI_BASE_URL=https://your-provider.example/v1
# Ollama示例：AI_BASE_URL=http://127.0.0.1:11434
MAX_UPLOAD_MB=200

# 可选：Tushare盘后日线与每日官方限价；需daily和stk_limit权限。
# 仅本地模拟，无券商/真实交易。配置存在不代表连接已验证。
TUSHARE_TOKEN=
